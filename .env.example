# Copy to .env. npm start loads the file automatically (Node.js 24+).
HOST=0.0.0.0
PORT=3100
# Use your HTTPS URL on Hetzner, for example https://kalender.example.de
PUBLIC_ORIGIN=http://localhost:3100
COOKIE_SECURE=false

# Creates Bruns / Test1234 once, without overwriting a changed password.
SEED_BRUNS=true
SEED_PASSWORD=Test1234
# Enable only behind the supplied reverse proxy (internal port, not public).
TRUST_PROXY=false

# Fill in your mail provider's SMTP values to enable account emails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Only for an unencrypted SMTP relay on localhost; leave false otherwise.
SMTP_LOCAL_RELAY=false
