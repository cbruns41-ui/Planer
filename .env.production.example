# Generate .env.production with scripts/configure-production.mjs instead of copying secrets.
APP_DOMAIN=kalender.example.de
ACME_EMAIL=admin@example.de
PUBLIC_ORIGIN=https://kalender.example.de
NODE_ENV=production
COOKIE_SECURE=true
TRUST_PROXY=true
SEED_BRUNS=true
# Used only when creating Bruns for the first time. Existing passwords are retained.
SEED_PASSWORD=replace-with-a-new-password-at-least-12-characters
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
SMTP_LOCAL_RELAY=false
